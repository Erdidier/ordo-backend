{
  "kind": "collectionType",
  "collectionName": "tags",
  "info": {
    "singularName": "tag",
    "pluralName": "tags",
    "displayName": "Tag",
    "description": "Etiquetas personales para organizar tareas"
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "name": {
      "type": "string",
      "required": true,
      "minLength": 1,
      "maxLength": 50
    },
    "color": {
      "type": "string",
      "maxLength": 7
    },
    "owner": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user",
      "inversedBy": "tags"
    },
    "tasks": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::task.task",
      "mappedBy": "tags"
    }
  }
}
