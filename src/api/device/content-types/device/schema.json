{
  "kind": "collectionType",
  "collectionName": "devices",
  "info": {
    "singularName": "device",
    "pluralName": "devices",
    "displayName": "Device"
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "token": {
      "type": "string",
      "required": true,
      "unique": true,
      "maxLength": 512
    },
    "platform": {
      "type": "enumeration",
      "enum": ["web", "ios", "android"],
      "required": true
    },
    "lastSeenAt": {
      "type": "datetime"
    },
    "owner": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user"
    }
  }
}
